{
  "name": "@ezeep/ezeep-js",
  "version": "1.0.0-alpha.0",
  "description": "A JavaScript library to enable easy and fast printing on any web application uising ezeep Blue.",
  "author": "Thinprint GmbH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezeep/ezeep-js.git"
  },
  "main": "dist/index.cjs.js",
  "module": "loader/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "loader/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/ezeep-js/ezeep-js.esm.js",
  "files": [
    "dist/",
    "loader/",
    "www/"
  ],
  "scripts": {
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "test.watch": "stencil test --spec --watchAll",
    "test.coverage": "stencil test --spec --coverage",
    "test.e2e": "stencil test --e2e",
    "test.all": "stencil test --spec --e2e",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "generate": "stencil generate",
    "stylelint": "stylelint \"src/**/*.scss\" --fix",
    "prettier": "prettier \"**/*.{json,ts,tsx,md,html}\" --write",
    "format": "npm run stylelint && npm run prettier",
    "prepare": "patch-package"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@cortado-holding/colors": "2.0.5",
    "@cortado-holding/utils": "^1.0.1",
    "@stencil/core": "^4.43.5",
    "fetch-intercept": "^2.4.0",
    "i18next": "^26.3.4",
    "whatwg-fetch": "^3.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rollup/plugin-replace": "3.0.0",
    "@stencil/angular-output-target": "^1.4.0",
    "@stencil/sass": "^3.2.3",
    "@stencil/store": "^2.2.2",
    "@types/css-font-loading-module": "^0.0.14",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "patch-package": "^8.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.4",
    "puppeteer": "^23.11.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "stylelint": "^17.14.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "htmlWhitespaceSensitivity": "strict",
    "overrides": [
      {
        "files": "src/data/locales/*.json",
        "options": {
          "tabWidth": 4
        }
      }
    ]
  },
  "stylelint": {
    "customSyntax": "postcss-scss",
    "plugins": [
      "stylelint-prettier",
      "stylelint-order"
    ],
    "rules": {
      "prettier/prettier": true,
      "order/order": [
        "dollar-variables",
        "custom-properties",
        "declarations",
        "rules",
        "at-rules"
      ],
      "order/properties-alphabetical-order": true
    }
  }
}
